{
  "name": "civic-research-hub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:mobile": "pnpm --filter @civic-research-hub/mobile dev",
    "dev:mobile:tunnel": "pnpm --filter @civic-research-hub/mobile dev:tunnel",
