{
  "expo": {
    "name": "CivicNote",
    "slug": "civicnote-mobile",
    "scheme": "civicnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D9151E"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "org.civicnote.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "CivicNote uses your photo library only when you choose an image to attach to research notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D9151E"
      },
      "package": "org.civicnote.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CivicNote uses your photo library only when you choose an image to attach to research notes."
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a98349dd-8f69-4f43-bfc7-d22b646e0b5b"
      }
    }
  }
}
